{
  "name": "@aefree/pi-markdown-utility",
  "version": "0.3.4",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "index.ts",
    "executables.ts",
    "unwrap-markdown.ts",
    "unwrap-markdown-cli.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "tsx tests/executables-validation.ts && tsx tests/unwrap-markdown-validation.ts",
    "unwrap": "tsx unwrap-markdown-cli.ts"
  },
  "dependencies": {
    "tsx": "4.23.9",
    "typebox": "^1.3.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "description": "Pi utility tools for opening and structurally formatting Markdown files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aefreedman/pi-markdown-utility.git"
  },
  "bugs": {
    "url": "https://github.com/aefreedman/pi-markdown-utility/issues"
  },
  "homepage": "https://github.com/aefreedman/pi-markdown-utility#readme",
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.0"
  }
}
